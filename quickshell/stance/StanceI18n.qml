import QtQuick
import Quickshell

// UI language. `lang` ("auto" | "en" | "tr") comes from panel.json through
// StanceService. Strings are keyed by their English source text: t(s) gives
// the translation or, when there is none, s itself. f(s, a, b) fills %1, %2.
Singleton {
    id: i18n

    property string lang: "auto"
    readonly property string envLang: Quickshell.env("LC_ALL") || Quickshell.env("LC_MESSAGES") || Quickshell.env("LANG") || ""
    // The language actually used: "en" or "tr".
    readonly property string effective: lang === "tr" || lang === "en" ? lang : (envLang.toLowerCase().startsWith("tr") ? "tr" : "en")

    function t(s) {
        if (effective === "en")
            return s;
        const v = tr[s];
        return v !== undefined ? v : s;
    }

    function f(s, ...args) {
        let out = t(s);
        for (let i = 0; i < args.length; i++)
            out = out.split("%" + (i + 1)).join(String(args[i]));
        return out;
    }

